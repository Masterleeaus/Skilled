{
  "name": "@lms/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:metadata": "node scripts/verify-metadata.mjs",
    "test:browser": "node tests/browser/academy-browser-suite.mjs --report ../../build/browser-report.json",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:brand": "node --test tests/brand-metadata.test.mjs",
    "predev": "node ../../scripts/prepare-public-assets.mjs",
    "prebuild": "node ../../scripts/prepare-public-assets.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "lucide-react": "^1.72.0",
    "next": "15.5.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lms/eslint-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.20",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "5.6.3",
    "vitest": "5.1.0"
  }
}
