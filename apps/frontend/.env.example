# Frontend environment template for local development.
# Copy to apps/frontend/.env.local (Next.js loads .env.local for the frontend):
#   cp apps/frontend/.env.example apps/frontend/.env.local

# Base URL of the backend API, including the /api prefix. Browser-visible (NEXT_PUBLIC_).
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Public frontend origin used to make Open Graph and Twitter image URLs absolute.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional, read by next.config.js to allow MinIO media in the Content-Security-Policy. Set the same values the
# backend uses (MINIO_ENDPOINT, MINIO_PORT, MINIO_USE_SSL) when media is served from MinIO during local development.
# MINIO_ENDPOINT="localhost"
# MINIO_PORT="9000"
# MINIO_USE_SSL="false"
