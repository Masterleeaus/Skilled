{
  "name": "@lms/backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run; vitest_status=$?; tsx --test 'tests/**/*.test.{mjs,cjs}'; node_status=$?; [ $vitest_status -eq 0 ] && [ $node_status -eq 0 ]",
    "test:node": "tsx --test 'tests/**/*.test.{mjs,cjs}'",
    "test:watch": "vitest",
    "integration:provision": "tsx prisma/provision-titan-integration.ts",
    "integration:credentials": "tsx prisma/manage-titan-credentials.ts",
    "curriculum:import": "tsx prisma/import-titan-curriculum.ts",
    "courses:sync": "tsx scripts/sync-courses-from-structure.ts",
    "publish:curriculum": "tsx scripts/publish-curriculum.ts",
    "publish:curriculum:watch": "tsx scripts/publish-curriculum.ts --watch",
    "curriculum:validate-cleaning": "node prisma/curriculum/cleaning/validate-cleaning-lessons.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "bullmq": "6.7.6",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "minio": "8.0.7",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "nodemailer": "10.5.0",
    "pdf-lib": "1.17.1",
    "socket.io": "4.8.4",
    "stripe": "22.3.2",
    "winston": "3.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lms/eslint-config": "workspace:*",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "^10.14.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "5.1.0"
  }
}
