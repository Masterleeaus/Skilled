# Backend environment template for local development.
# Copy to apps/backend/.env (the API loads .env from its own working directory):
#   cp apps/backend/.env.example apps/backend/.env
#
# Values below match docker-compose.local-dev.yml. Anything marked
# "replace before any non-local use" must be changed before the API is exposed
# beyond your machine. Never commit a real .env file.

# --- Runtime -----------------------------------------------------------------
# development | production | test. Production enforces stricter checks
# (dedicated titan_academy database, HTTPS CLIENT_URL, 32+ char JWT secrets).
NODE_ENV="development"
# Port and bind address for the API.
PORT=5000
HOST="127.0.0.1"

# Frontend origin used for CORS and generated links. Must be a full URL.
CLIENT_URL="http://localhost:3000"

# --- Database and cache (required) -------------------------------------------
# PostgreSQL connection string. Matches the postgres service in docker-compose.local-dev.yml.
DATABASE_URL="postgresql://lms:lms@localhost:5432/lms?schema=public"
# Redis connection string for queues and the health check. No credentials in the URL.
REDIS_URL="redis://localhost:6379"
# Redis AUTH password (optional). Leave empty for the local Redis, which has no AUTH.
REDIS_PASSWORD=""

# --- Auth (required) ---------------------------------------------------------
# Signing secrets for access and refresh tokens. Each must be at least 32 characters
# in every environment, and the two must differ. Replace before any non-local use.
JWT_ACCESS_SECRET="dev-access-secret-change-me-local-only"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-local-only"
# Token lifetimes (optional, shown with defaults).
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# --- Object storage (MinIO / S3-compatible) ----------------------------------
# Host and port of the MinIO server. Defaults target the local docker-compose MinIO.
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
# Credentials match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.local-dev.yml.
# Replace before any non-local use.
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
# Bucket is created on startup if missing (optional, shown with default).
MINIO_BUCKET="lms-storage"
# "true" to use HTTPS to reach MinIO (optional, default "false").
MINIO_USE_SSL="false"

# Lesson video upload admission control (optional, shown with defaults).
# Maximum video uploads in progress for one user. Extra requests get HTTP 429.
VIDEO_UPLOAD_MAX_CONCURRENT_PER_USER=2
# Maximum declared bytes of in-flight video uploads across all users (temporary disk use).
# Must be at least 525336576 (500MB plus multipart allowance). Extra requests get HTTP 503.
VIDEO_UPLOAD_MAX_INFLIGHT_BYTES=2147483648

# Assignment attachment upload admission control (optional, shown with defaults).
# Maximum attachment submissions in progress for one user. Extra requests get HTTP 429.
ASSIGNMENT_UPLOAD_MAX_CONCURRENT_PER_USER=2
# Maximum attachment submissions in progress across all users. Extra requests get HTTP 503.
ASSIGNMENT_UPLOAD_MAX_CONCURRENT_GLOBAL=8
# Maximum declared bytes of in-flight attachment submissions across all users (temporary disk use).
# Must be at least 105906176 (5 x 20MB plus multipart allowance). Extra requests get HTTP 503.
ASSIGNMENT_UPLOAD_MAX_INFLIGHT_BYTES=536870912

# --- Email (SMTP) ------------------------------------------------------------
# Defaults target MailHog from docker-compose.local-dev.yml (port 1025, no auth).
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="no-reply@lms.local"
# none | starttls | implicit. Production must not use "none".
SMTP_TLS_MODE="none"
# Set both SMTP_USER and SMTP_PASSWORD together, or leave both empty.
SMTP_USER=""
SMTP_PASSWORD=""

# --- Curriculum ----------------------------------------------------------------
# Root folder for curriculum files (courses/ and shared/). Empty uses the repo's curriculum/ folder.
CURRICULUM_DIR=""

# --- Stripe (optional) ---------------------------------------------------------
# Leave both empty for local development. In production both are required; startup fails if either is missing.
# Use Stripe test-mode keys only in development.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
