{
  "name": "lms",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter ./apps/* build",
    "lint": "pnpm --filter ./apps/* lint",
    "curriculum:ci": "node scripts/ci-curriculum-audit.mjs --fail-on-blocked --report build/curriculum-ci-report.json",
    "test:academy:backend": "cd apps/backend && npx vitest run src/tests/academy-enrolment-progress.test.ts src/tests/academy-snapshot-history.test.ts src/tests/academy-completion-report.test.ts",
    "test:source": "node scripts/run-source-verification.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "bcrypt",
      "@prisma/client",
      "prisma"
    ]
  }
}
