# Titan Academy production environment TEMPLATE.
#
# Placeholders only. Never put a real value in this file, a commit, a ticket or a chat.
# Copy it to a private file that only the service user can read (mode 0600), fill every
# <set-in-secret-store> value from your secret store, and do not commit the filled copy.
# See docs/INSTALL.md section 3 and docs/runbooks/secrets-handling.md.
#
# Variable names match apps/backend/src/config/env.ts (validated at start-up) and the
# NEXT_PUBLIC_ build variable read by apps/frontend. The backend also reads the optional
# flags at the end of this file directly from process.env.
#
# App-specific development templates (not for production):
#   apps/backend/.env.example   -> copy to apps/backend/.env
#   apps/frontend/.env.example  -> copy to apps/frontend/.env.local

# --- Runtime ------------------------------------------------------------------
NODE_ENV="production"
PORT=5000
HOST="127.0.0.1"

# Public HTTPS origin of the frontend. Production refuses any value not starting with https://.
CLIENT_URL="https://<academy-frontend-host>"

# --- Database and cache (required) --------------------------------------------
# Production requires the dedicated titan_academy database AND role. Any other name is refused.
# PostgreSQL 16 on the Academy instance (port per DEPLOY-RUNBOOK.md section 1).
DATABASE_URL="postgresql://titan_academy:<set-in-secret-store>@127.0.0.1:5433/titan_academy?schema=public"
# Redis for queues and the health check. Version and port are not confirmed by the repository.
# The URL carries no credentials: env.ts refuses a password inside REDIS_URL.
REDIS_URL="redis://127.0.0.1:6379"
# Redis AUTH password, supplied separately from the URL. Leave empty only for a Redis with no AUTH.
REDIS_PASSWORD="<set-in-secret-store>"

# --- Auth (required) ----------------------------------------------------------
# Every environment requires each secret to be at least 32 characters and the two to differ.
# Generate each with a CSPRNG (for example: openssl rand -base64 48). Never reuse Field or Desk values.
JWT_ACCESS_SECRET="<set-in-secret-store>"
JWT_REFRESH_SECRET="<set-in-secret-store>"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# --- Object storage: MinIO or S3-compatible (required) ------------------------
MINIO_ENDPOINT="<minio-host>"
MINIO_PORT=9000
MINIO_ACCESS_KEY="<set-in-secret-store>"
MINIO_SECRET_KEY="<set-in-secret-store>"
MINIO_BUCKET="lms-storage"
# "true" when MinIO is reached over HTTPS. Use "false" only for a loopback-only MinIO without TLS.
MINIO_USE_SSL="true"

# --- Email (SMTP) -------------------------------------------------------------
SMTP_HOST="<smtp-host>"
# 587 for starttls, 465 for implicit TLS (env.ts requires 465 with implicit).
SMTP_PORT=587
SMTP_FROM="<no-reply-address>"
# Production must be "starttls" or "implicit". "none" is refused.
SMTP_TLS_MODE=starttls
# Supply SMTP_USER and SMTP_PASSWORD together, or leave both empty.
SMTP_USER="<set-in-secret-store>"
SMTP_PASSWORD="<set-in-secret-store>"

# --- Curriculum ---------------------------------------------------------------
# Empty uses the repository's curriculum/ folder. Set only to an absolute path you control.
CURRICULUM_DIR=""

# --- Stripe (optional) --------------------------------------------------------
# Production requires BOTH values or NEITHER. Leave both empty if payments are not enabled.
# When enabling, use live keys from the secret store only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Integration fail-closed scopes (required for integration routes) ---------
# JSON with both keys. An unset or invalid value makes every integration call return 401.
# Each array lists external company references allowed for that caller.
INTEGRATION_SERVICE_SCOPES='{"field-services":["<company-ref>"],"ai-workforce":["<company-ref>"]}'

# --- Optional flags read from process.env --------------------------------------
# Leave unset in production: the publication gate is ON by default.
# ACADEMY_PUBLICATION_GATE=""
# Path to the assessment approvals file. Unset uses <curriculum root>/assessment-publication-approvals.json.
# ACADEMY_ASSESSMENT_APPROVALS=""
# Tutor module is off unless the value is exactly "true".
TUTOR_ENABLED="false"

# --- Frontend build variable (set at build time, browser-visible) -------------
# Base URL of the backend API including /api. Must be the public HTTPS API origin.
NEXT_PUBLIC_API_URL="https://<academy-api-host>/api"
