# Skilled (LMS) runtime configuration for Titan Central integration (issue #161).
# PLACEHOLDERS ONLY. Copy to a secret store, never commit real values.
# Owner decisions still open: the public LMS origin below (<LMS_PUBLIC_ORIGIN>) is NOT confirmed.

# --- Central OIDC login (parseSkilledOidcConfig, off unless ENABLED is "true") ---
SKILLED_CENTRAL_OIDC_ENABLED=false
SKILLED_CENTRAL_OIDC_ISSUER=<CENTRAL_OIDC_ISSUER_ORIGIN>
SKILLED_CENTRAL_OIDC_CLIENT_ID=<LMS_OIDC_CLIENT_ID>
SKILLED_CENTRAL_OIDC_CLIENT_SECRET=<LMS_OIDC_CLIENT_SECRET>
SKILLED_CENTRAL_OIDC_REDIRECT_URI=<LMS_PUBLIC_ORIGIN>/auth/titan/academy/callback
SKILLED_CENTRAL_OIDC_STATE_KEY=<BASE64_32_BYTE_KEY>

# The service-decision client (issue #158) adds TITAN_SKILLED_DECISION_BEARER and
# TITAN_SKILLED_DECISION_ENDPOINT. See docs/SKILLED-CENTRAL-DECISION-CLIENT.md. They are not listed here
# until #158 is merged, because this file must match the code on the branch it ships with.
